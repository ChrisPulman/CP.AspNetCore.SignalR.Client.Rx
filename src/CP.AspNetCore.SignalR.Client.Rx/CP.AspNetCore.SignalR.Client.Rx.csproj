<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net472;net48;net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([System.String]::Copy('$(NETCoreSdkVersion)').StartsWith('10.')) != 'True'">$(TargetFrameworks);net11.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="ReactiveUI.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Channels" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Microsoft.AspNetCore.SignalR.Client" />
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Extensions" />
    <Using Include="ReactiveUI.Primitives.Disposables.MultipleDisposable" Alias="CompositeDisposable" />
    <Using Include="ReactiveUI.Primitives.Disposables.Scope" Alias="Disposable" />
    <Using Include="ReactiveUI.Primitives.RxVoid" Alias="RxVoid" />
    <Using Include="ReactiveUI.Primitives.Signals.Signal" Alias="Observable" />
  </ItemGroup>

</Project>
